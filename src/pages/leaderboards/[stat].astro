---
import Step from "@/src/components/Step.astro";
import { format, getLeaderboard } from "@/src/constants/leaderboards";
import Layout from "@/src/layouts/Layout.astro";
import { fetchLeaderboard } from "@/src/lib/leaderboardUtils";

export const prerender = false;

const { stat } = Astro.params;
const lb = getLeaderboard(stat!);

if (!lb) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const { leaderboard: obj, category } = lb;

const result = await fetchLeaderboard(stat!, lb.leaderboard.sort ?? -1);
---

<Layout
  title={`${category.name}: ${obj.name}`}
  ogImage={`${Astro.site}leaderboards/${stat}/opengraph-image.png`}>
  <main>
    <h1 class="text-center text-3xl font-bold">{obj.name}</h1>
    <h2 class="text-center text-xl">
      {category?.mode ? `${category?.name}: ${category?.mode}` : category?.name}
    </h2>
    <div class="mx-auto w-max">
      {
        result?.map((item, i) => {
          return (
            <Step number={i + 1}>
              <div class="inline-flex w-72 justify-between md:w-96">
                <span>
                  <a
                    href={`/player/${item.username}`}
                    class="font-medium underline">
                    {item.username}
                  </a>
                </span>
                <span>{format(obj?.format, item.value)}</span>
              </div>
            </Step>
          );
        })
      }
    </div>
  </main>
</Layout>
