---
import Layout from "@/src/layouts/Layout.astro";
import ViewStats from "@/src/components/ViewStats.astro";
---

<Layout
  title="Player Stats"
  description="Look up any BlueDragon player's profile and statistics by username.">
  <main class="px-auto mx-auto flex h-[80vh] w-full justify-center">
    <div class="flex flex-col justify-center">
      <h1 class="text-center text-3xl font-bold">Statistics</h1>
      <p class="mb-8 text-center">
        Enter a player&apos;s username to view their individual statistics.
      </p>
      <ViewStats />
    </div>
  </main>
</Layout>