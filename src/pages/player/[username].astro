---
import RelativeDate from "@/src/components/RelativeDate.astro";
import Statistic from "@/src/components/Statistic.astro";
import {
  format,
  getLeaderboard,
  leaderboards,
} from "@/src/constants/leaderboards";
import Layout from "@/src/layouts/Layout.astro";
import { fetchPosition } from "@/src/lib/leaderboardUtils";
import { fetchPlayer } from "@/src/lib/playerUtils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import TimeAgo from "javascript-time-ago";
import en from "javascript-time-ago/locale/en";

TimeAgo.addDefaultLocale(en);

export const prerender = false;

const { username } = Astro.params;

const info = await fetchPlayer(username!);
if (!info) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const nonDashedUUID = info.uuid.replaceAll(/-/g, "");
const timeAgo = new TimeAgo("en-US");

const rank = info.meta?.primaryGroup
  ? info.meta.primaryGroup.charAt(0)?.toUpperCase() +
    info.meta.primaryGroup.substring(1)
  : undefined;

let darkRankText = false;

if (info.meta?.rankcolor) {
  const rankColorValue = Number("0x" + info.meta.rankcolor.substring(1));
  const r = (rankColorValue >> 16) & 0xff;
  const g = (rankColorValue >> 8) & 0xff;
  const b = rankColorValue & 0xff;
  const luminance = 0.289 * r + 0.587 * g + 0.114 * b;
  if (luminance > 100) darkRankText = true;
}

const ranks: { [key: string]: number } = {};

await Promise.all(
  Object.keys(info.stats).map((stat) => {
    return fetchPosition(
      info.username,
      stat,
      getLeaderboard(stat)?.leaderboard.sort ?? -1,
    ).then((info) => {
      if (info !== undefined) {
        ranks[info.statistic] = info.position;
      }
    });
  }),
);
---

<Layout
  title={`${info.username}'s Stats`}
  description={`View ${info.username}'s BlueDragon profile and statistics online.`}
  ogType="profile"
  ogImage={new URL(`/player/${username}/opengraph-image.png`, Astro.site)}>
  <main>
    <h1 class="text-center text-3xl font-bold">
      <Image
        priority
        src={`https://minotar.net/helm/${nonDashedUUID}/16`}
        alt={`${username}'s Minecraft player head`}
        width={32}
        height={32}
        class="inline rounded-sm align-middle [image-rendering:pixelated]"
      />
      <span class="ml-2">{username}</span>
      {
        rank && info.meta?.rankcolor && (
          <span
            class={`mx-4 rounded-full p-2 align-middle text-xs font-medium uppercase ${
              darkRankText ? "text-black" : "text-white"
            }`}
            style={{ backgroundColor: info.meta?.rankcolor }}>
            {rank}
          </span>
        )
      }
    </h1>

    <a
      class="mx-auto my-4 block w-max rounded-md bg-black p-2 text-sm text-white dark:bg-white dark:text-black"
      href={`https://namemc.com/profile/${info.uuid}`}
      rel="noopener noreferrer"
      target="_blank">
      <Icon
        name="fa7-solid:up-right-from-square"
        width={14}
        height={14}
        class="inline"
      />{" "}
      NameMC
    </a>

    <Statistic
      name="First Login"
      value={info.firstLogin ? timeAgo.format(info.firstLogin) : undefined}>
      <RelativeDate
        date={info.firstLogin}
        text={info.firstLogin ? timeAgo.format(info.firstLogin) : "-"}
      />
    </Statistic>
    <Statistic
      name="Last Login"
      value={info.lastLogin ? timeAgo.format(info.lastLogin) : undefined}>
      <RelativeDate
        date={info.lastLogin}
        text={info.lastLogin ? timeAgo.format(info.lastLogin) : "-"}
      />
    </Statistic>
    <Statistic
      name="Network Level"
      value={Math.round(info.level * 100) / 100}
    />
    <Statistic name="Owned Cosmetics" value={info.cosmeticCount} />
    {
      leaderboards.map((category) => (
        <div>
          <h1 class="mb-2 mt-6 text-center text-2xl font-bold">
            {category.mode
              ? `${category.name}: ${category.mode}`
              : category.name}
          </h1>
          {category.leaderboards.map((lb) => (
            <Statistic
              name={lb.statName ?? lb.name}
              stat={lb.stat}
              value={format(lb.format, info.stats[lb.stat])}
              position={ranks[lb.stat]}
            />
          ))}
        </div>
      ))
    }
  </main>
</Layout>
