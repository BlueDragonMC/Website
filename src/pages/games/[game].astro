---
import Gallery from "@/src/components/Gallery.astro";
import Step from "@/src/components/Step.astro";
import { games } from "@/src/constants/games";
import Layout from "@/src/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";

const gameName = Astro.params["game"];
const title = decodeURIComponent(gameName).toLowerCase().replaceAll(/-/g, " ");
const game = games.find((g) => g.name.toLowerCase() === title);

if (!game) {
  return Astro.rewrite("/404");
}

export const prerender = true;

export const getStaticPaths = (() => {
  return games.map((game) => ({
    params: { game: game.name.toLowerCase().replaceAll(/ /g, "-") },
  }));
}) satisfies GetStaticPaths;

const steps = game.steps;
---

<Layout ogImage={`${Astro.site}games/${game.name.toLowerCase().replaceAll(/ /g, "-")}/opengraph-image.png`}>
  <main>
    <h1 class="mb-2 text-3xl font-bold">{game.name}</h1>
    {
      games.map((other) => {
        return (
          <a
            href={`/games/${other.name.toLowerCase().replaceAll(/ /g, "-")}`}
            class={`${
              game.name == other.name
                ? "bg-blue-700 text-white"
                : "mb-2 bg-slate-200 text-black"
            } mr-2 inline-block cursor-pointer rounded-md p-2 font-medium transition-colors`}>
            {other.name}
          </a>
        );
      })
    }

    <p class="my-5">{game.description}</p>
    <Gallery images={game.images ?? []} altText="Gameplay screenshot" />
    {game.steps && <h2 class="mb-4 text-2xl font-bold">How to Play</h2>}
    {
      Array.isArray(steps)
        ? steps?.map((step, i) => {
            return <Step number={i + 1}>{step}</Step>;
          })
        : Object.keys(steps!).map((mode) => {
          if (!steps) return <></>;
          const modeSteps = steps![mode];
            return (
              <div>
                <h3 class="text-xl font-bold">{mode}</h3>
                {modeSteps.map((step, i) => {
                  return <Step number={i + 1}>{step}</Step>;
                })}
              </div>
            );
          })
    }
  </main>
</Layout>
