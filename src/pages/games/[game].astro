---
import GamePage from "@/src/components/GamePage.astro";
import { games } from "@/src/constants/games";
import Layout from "@/src/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";

const gameName = Astro.params["game"];
const title = decodeURIComponent(gameName).toLowerCase().replaceAll(/-/g, " ");
const game = games.find((g) => g.name.toLowerCase() === title);

if (!game) {
  return Astro.rewrite("/404");
}

export const prerender = true;

export const getStaticPaths = (() => {
  return games.map((game) => ({
    params: { game: game.name.toLowerCase().replaceAll(/ /g, "-") },
  }));
}) satisfies GetStaticPaths;
---

<Layout
  title={game.name}
  description={game.description}
  ogType="article"
  ogImage={new URL(
    `/games/${game.name.toLowerCase().replaceAll(/ /g, "-")}/opengraph-image.png`,
    Astro.site,
  )}>
  <GamePage game={game} />
</Layout>
