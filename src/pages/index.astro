---
import lobby3 from "@/assets/games/lobby/lobby-3.png";
import wackymaze1 from "@/assets/games/wackymaze/wackymaze-1.png";
import wackymaze6 from "@/assets/games/wackymaze/wackymaze-6.png";
import hero1 from "@/assets/hero/1.png";
import hero2 from "@/assets/hero/2.png";
import hero3 from "@/assets/hero/3.png";
import hero5 from "@/assets/hero/5.png";
import jukeboxImage from "@/assets/images/jukebox-1.png";
import leaderboardImage from "@/assets/images/leaderboards-1.png";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import { games } from "../constants/games";
import { leaderboards } from "../constants/leaderboards";
import Layout from "../layouts/Layout.astro";

const images = [hero1, hero2, hero3, hero5, lobby3, wackymaze1, wackymaze6];
const newestGameImages = games[0].images!;

const lbCount = leaderboards
  .map((category) => category.leaderboards.length)
  .reduce((acc, category) => acc + category, 0);

// Games whose steps are keyed by mode have one mode per key; all others have
// one. HueHunters' step keys are roles, not modes, so it counts as one.
const gameModeCount = games.reduce(
  (acc, game) =>
    acc +
    (!game.steps ||
    Array.isArray(game.steps) ||
    game.name === "HueHunters"
      ? 1
      : Object.keys(game.steps).length),
  0,
);
---

<Layout ogImage={new URL("/opengraph-image.png", Astro.site)}>
  <main>
    <section class="relative -mx-2 -mt-4 h-screen min-h-240 w-screen md:-mx-10">
      <div class="absolute top-0 left-0 -z-20 h-full w-full overflow-hidden">
        <ImageCarousel
          images={newestGameImages}
          altText="Gameplay Screenshot"
          blurred={true}
          imageWidth={512}
        />
      </div>
      <div
        class="absolute top-0 left-0 mx-auto h-full w-full rounded-lg p-4 text-white">
        <div class="mx-auto mt-48 max-w-4xl text-center">
          <h1 class={`font-black drop-shadow-2xl`}>
            <span
              class={`my-4 block bg-linear-to-tl from-red-700 to-orange-500 bg-clip-text text-5xl font-black leading-normal text-transparent md:text-7xl lg:text-8xl xl:text-9xl font-rubik-marker-hatch`}>
              DOMINATE
            </span>
          </h1>
          <p class="my-2 text-2xl">
            A new spin on an old classic: rally your friends, plan your
            strategy, and win the battle to capture the most points!
          </p>
          <Button href="/join">Join</Button>
          <Button
            iconPosition="right"
            intent="secondary"
            href="/blog/2023-07-03-dominate-1-20">
            <Icon slot="icon" name="fa7-solid:arrow-right" />
            Read the Blog Post
          </Button>
        </div>
      </div>
      <div class="group absolute top-[80%] w-full">
        <a href="#about" aria-hidden="true">
          <div class="mx-auto hidden w-min lg:block">
            <Icon
              name="fa7-solid:arrow-down-long"
              class="h-8 w-8 text-white transition-colors group-hover:text-blue-500 motion-safe:animate-bounce"
            />
          </div>
        </a>
      </div>
    </section>
    <section
      class="my-10 mx-auto grid grid-cols-1 gap-x-8 lg:max-w-[130ch] lg:grid-cols-2">
      <div id="about" class="mt-8">
        <h2 class="text-3xl font-bold">About Us</h2>
        <p>
          BlueDragon is a Minecraft server that strives to produce high-quality,
          original content. Join for free to explore unique minigames like
          Paintbrawl, WackyMaze, and more!
        </p>
        <Button href="/join">
          <Icon slot="icon" name="fa7-solid:share" />
          Join Now
        </Button>
      </div>
      <div class="my-4 h-72 overflow-hidden rounded-lg">
        <ImageCarousel
          images={images}
          altText="Gameplay screenshot"
          blurred={false}
          imageWidth={540}
          delay={4.0}
        />
      </div>
    </section>
    <section
      class="my-10 mx-auto grid grid-cols-1 gap-x-8 lg:max-w-[130ch] lg:grid-cols-2">
      <div
        class="row-start-2 my-4 w-4/5 min-w-[24rem] rounded-lg bg-neutral-900 p-4 lg:row-start-1">
        {
          games.map((game, i) => (
            <a
              href={`/games/${game.name.toLowerCase().replaceAll(/ /g, "-")}`}
              class="mr-2 inline-block text-2xl font-black text-neutral-500 transition-colors hover:text-neutral-200">
              {game.name}
              {i !== games.length - 1 && (
                <span class="ml-2 text-2xl text-neutral-700">&middot;</span>
              )}
            </a>
          ))
        }
      </div>
      <div class="row-start-1">
        <h2 class="text-3xl font-bold">Game Selection</h2>
        <p>
          BlueDragon has {games.length} Minecraft minigames and{" "}
          {gameModeCount} total game modes, across all genres. Parkour, combat,
          strategy, we have it all.
        </p>
        <Button href="/games">
          <Icon slot="icon" name="fa7-solid:gamepad" />
          View Games
        </Button>
      </div>
    </section>
    <section
      class="my-10 mx-auto grid grid-cols-1 gap-x-8 lg:max-w-[130ch] lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold">Jukebox</h2>
        <p>
          Play a collection of note block songs in-game. Just type{" "}
          <code>/play</code> and your music will play. You can play music in any game,
          at any time, automatically continuing between games.
        </p>
        <Button href="/join">
          <Icon slot="icon" name="fa7-solid:share" />
          Join Now
        </Button>
      </div>
      <Image
        src={jukeboxImage}
        alt="Jukebox menu screenshot"
        class="my-4 rounded-lg"
      />
    </section>
  </main>
  <section
    class="my-10 mx-auto grid grid-cols-1 gap-x-8 lg:max-w-[130ch] lg:grid-cols-2">
    <Image
      src={leaderboardImage}
      alt="Lobby leaderboard screenshot"
      class="row-start-2 my-4 max-h-72 rounded-lg object-cover lg:row-start-1"
    />
    <div class="row-start-1">
      <h2 class="text-3xl font-bold">Leaderboards</h2>
      <p>
        You can view{" "}
        <span class="font-bold">
          {lbCount} leaderboards
        </span>{" "}
        on the BlueDragon website and in-game. Get to the top by being the best!
      </p>
      <Button href="/leaderboards">
        <Icon slot="icon" name="fa7-solid:trophy" />
        View Leaderboards
      </Button>
    </div>
  </section>
  <section class="flex flex-col justify-center">
    <div>
      <h2 class="text-center text-3xl font-bold">Open-Source</h2>
      <p class="text-center">
        We ❤️ open source! Our core software, website, and Jukebox are all
        open-sourced on GitHub.
      </p>
    </div>
    <div class="text-center">
      <Button href="/github">
        <Icon slot="icon" name="mdi:github" />
        View on GitHub
      </Button>
      <Button href="/page/oss" intent="secondary">
        <Icon slot="icon" name="fa7-solid:code-fork" />
        View Open-Source Software
      </Button>
    </div>
  </section>
</Layout>
