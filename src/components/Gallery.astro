---
import { getImage } from "astro:assets";

interface Props {
  images: Array<ImageMetadata>;
  altText: string | string[];
}

const { images, altText } = Astro.props;

const thumbnails = await Promise.all(
  images.map((image) => getImage({ src: image, width: 480 })),
);
---

<image-gallery>
  {
    images.map((img, i) => (
      <a
        href={img.src}
        data-pswp-width={img.width}
        data-pswp-height={img.height}>
        <img
          class="mb-4 mr-4 inline cursor-pointer rounded-md"
          src={thumbnails[i].src}
          alt={Array.isArray(altText) ? altText[i] : altText}
        />
      </a>
    ))
  }
</image-gallery>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  class ImageGallery extends HTMLElement {
    connectedCallback() {
      const lightbox = new PhotoSwipeLightbox({
        gallery: this,
        children: this.querySelectorAll("a"),
        pswpModule: () => import("photoswipe"),
      });

      lightbox.init();
    }
  }

  customElements.define("image-gallery", ImageGallery);
</script>
