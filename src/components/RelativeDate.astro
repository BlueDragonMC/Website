---
interface Props {
  date?: Date | number | string;
  text?: string;
}

const { date: dateIn, text } = Astro.props;
const date = dateIn === undefined ? undefined : new Date(dateIn);
---

{
  date ? (
    <time
      datetime={date.toISOString()}
      title={new Intl.DateTimeFormat(undefined, {
        dateStyle: "long",
        timeStyle: "long",
      }).format(date)}>
      {text}
    </time>
  ) : (
    <time datetime={new Date().toISOString()}>
      {new Intl.DateTimeFormat(undefined, {
        dateStyle: "short",
        timeStyle: "short",
      }).format()}
    </time>
  )
}
