---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"blog">;
}

const { article } = Astro.props;

const created = new Intl.DateTimeFormat(undefined, {
  dateStyle: "medium",
  timeStyle: undefined,
}).format(article.data.created);
---

<a href={"/blog/" + article.id}>
  <div
    class="group rounded-lg bg-gray-200 shadow-lg transition-all hover:bg-gray-300 hover:shadow-2xl dark:bg-neutral-900 dark:hover:bg-neutral-800">
    {
      article.data.image && (
        <Image
          src={article.data.image}
          alt={article.data.title}
          width={1024}
          height={0}
          widths={[320, 544, 768]}
          sizes="(min-width: 48rem) 34rem, calc(100vw - 2rem)"
          class="h-24 w-full rounded-t-lg object-cover transition-all group-hover:brightness-75"
        />
      )
    }
    <div class="p-3">
      <h2 class="mb-auto text-2xl font-medium">
        {article.data.title}
      </h2>
      <div class="flex flex-wrap items-center py-3">
        <Icon name="fa7-solid:user" class="mr-2 size-4 align-middle" />
        <span class="font-medium">{article.data.author}</span>
        <Icon name="fa7-solid:calendar" class="mx-2 size-4 align-middle" />
        <time datetime={article.data.created.toISOString()}>{created}</time>
      </div>
      <p
        class={`text-gray-800 dark:text-gray-300 ${
          article.data.image ? "line-clamp-3" : "line-clamp-6"
        }`}>
        {article.data.description}
      </p>
    </div>
  </div>
</a>
