---
import favicon from "@/public/favicon_hq.png";
import logo from "@/public/logo_wordmark.png";
import { Icon } from "astro-icon/components";
import NavItem from "../components/NavItem.astro";
---

<header class="z-50 h-16 print:hidden">
  <nav
    class={`fixed top-0 z-50 flex h-16 w-full items-center justify-center bg-gray-900 md:justify-between`}>
    <div class={`flex items-center justify-center md:justify-start`}>
      <a href="/">
        <img
          src={logo.src}
          class="mx-4 hidden md:block"
          alt="BlueDragon Logo"
          height={30}
          width={155}
        />
        <img
          src={favicon.src}
          class="mx-4 md:hidden"
          alt="BlueDragon Logo"
          height={48}
          width={48}
        />
      </a>
    </div>
    <div class={`flex h-full flex-1 items-center justify-end space-x-4 px-4`}>
      <NavItem text="Home" href="/">
        <Icon slot="icon" name="fa7-solid:house" />
      </NavItem>
      <NavItem text="Games" href="/games">
        <Icon slot="icon" name="fa7-solid:gamepad" />
      </NavItem>
      <NavItem text="Blog" href="/blog">
        <Icon slot="icon" name="fa7-solid:book" />
      </NavItem>
      <NavItem text="Leaderboards" href="/leaderboards">
        <Icon slot="icon" name="fa7-solid:ranking-star" />
      </NavItem>
      <NavItem
        text="Join"
        href="/join"
        color="bg-blue-600 hover:bg-blue-700"
        activeColor="bg-blue-500 hover:bg-blue-600">
        <Icon slot="icon" name="fa7-solid:share" />
      </NavItem>
    </div>
  </nav>
</header>
